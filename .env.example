# Copy this file to .env and fill in your real key
# .env is gitignored — never commit real keys!

# Your FREE-tier Gemini API key (no billing account needed)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_FREE_API_KEY=your_free_gemini_api_key_here

# Your PAID-tier Gemini API key (requires billing account, for faster/batch processing)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_PAID_API_KEY=your_paid_gemini_api_key_here
