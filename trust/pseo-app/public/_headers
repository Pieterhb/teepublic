# Cloudflare Pages custom HTTP response headers

# RSS feeds: serve with correct MIME type and CORS for Pinterest & all RSS readers.
# Cache-Control: 5-minute max-age so Pinterest's bot always fetches the freshest feed.
# A 1-hour cache caused Pinterest to see a stale version for up to 60 minutes after deploy.
/rss/*.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

# Sitemaps
/sitemap*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400, s-maxage=86400

# All pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
